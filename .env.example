# Build-time, non-secret configuration. Copy to `.env` for local builds; set the
# same values as plain environment variables on the Cloudflare build.
#
# Everything here is public: PUBLIC_ vars are inlined into the page, and the two
# addresses are visible in the mail they produce. Secrets live in `.dev.vars`
# locally and in Worker secrets in production — never here.

# The Turnstile *site* key (public, renders into the widget markup).
# Defaults to Cloudflare's always-passes test key, which must be overridden in
# production. A real TURNSTILE_SECRET_KEY rejects tokens minted by the test key,
# so forgetting this breaks the form loudly rather than disabling the challenge.
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Where enquiries are delivered.
CONTACT_TO_EMAIL="hello@blinto.co"

# The sender. Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Blinto <noreply@blinto.co>"
