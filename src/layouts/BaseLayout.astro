---
import { getImage } from 'astro:assets';
import '~/styles/global.css';
import NavBar from '~/components/layout/NavBar.astro';
import Footer from '~/components/layout/Footer.astro';
import { contact } from '~/data/site';
import type { FaqEntry } from '~/components/sections/Faq.astro';
import {
  ORG_NAME,
  buildGraph,
  faqNode,
  serviceNode,
  type PageType,
  type SchemaContext,
} from '~/data/seo';

interface Props {
  title: string;
  description: string;
  /**
   * The page's share image. Pass an imported image — a page's own hero banner,
   * as the current WordPress site does — and it is cropped to the 1200x630 card
   * at build time. A string is used as a path verbatim. Omitted, the page falls
   * back to the site card.
   */
  ogImage?: string | ImageMetadata;
  /**
   * schema.org type for this page's WebPage node. `WebPage` unless the page is
   * genuinely one of the narrower kinds — About, Contact, a collection.
   */
  pageType?: PageType;
  /**
   * The page's FAQ band. Pass the same array the `Faq` section renders and the
   * markup and the structured data cannot drift apart.
   */
  faqs?: FaqEntry[];
  /** Set on a page that sells one service, for its Service node. */
  service?: { name: string; description: string; serviceType?: string };
  /**
   * Keeps the page out of search results and, because `seo.mjs` reads the
   * built markup, out of `sitemap.xml` and `llms.txt` too. For pages that
   * exist only as the far side of an action, like the thank-you page the
   * contact form lands on.
   */
  noindex?: boolean;
  /**
   * Anything else this page is about — job postings, products, reviews. These
   * join the page's own `@graph` rather than sitting in a second script, so
   * they can reference the shared Organization and WebPage by `@id`. Pass a
   * function when a node needs those ids or the canonical URL.
   */
  schema?:
    | Record<string, unknown>[]
    | ((context: SchemaContext) => Record<string, unknown>[]);
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  pageType = 'WebPage',
  faqs,
  service,
  noindex = false,
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/**
 * Open Graph wants a real file at a fixed 1.91:1, so an imported image is run
 * through the build pipeline at 1200x630 rather than being linked at its own
 * dimensions. Scrapers are the least capable clients on the web, so this stays
 * a plain JPEG — no WebP, no srcset.
 */
const ogAsset =
  typeof ogImage === 'string'
    ? ogImage
    : (
        await getImage({
          src: ogImage,
          width: 1200,
          height: 630,
          format: 'jpeg',
          quality: 80,
        })
      ).src;

const ogImageUrl = new URL(ogAsset, canonical);

const context: SchemaContext = { canonical, origin: canonical.origin };

const graph = buildGraph({
  canonical,
  title,
  description,
  imageUrl: ogImageUrl.href,
  pageType,
  extra: [
    ...(service ? [serviceNode(canonical, service)] : []),
    ...(faqs?.length ? [faqNode(canonical, faqs)] : []),
    ...(typeof schema === 'function' ? schema(context) : schema),
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-M8K9HQSP');
    </script>
    <!-- End Google Tag Manager -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#1945eb" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ORG_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${ORG_NAME} — ${title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={contact.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(graph)}
    />

    <slot name="head" />
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-M8K9HQSP"
        height="0"
        width="0"
        style="display: none; visibility: hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <a class="skip-link" href="#main">Skip to content</a>
    <NavBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
