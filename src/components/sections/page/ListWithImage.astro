---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import ListCard from '~/components/ui/ListCard.astro';
import ImageCard from '~/components/ui/ImageCard.astro';
import LargeButton from '~/components/ui/LargeButton.astro';
import type { CtaAction } from '~/components/sections/Cta.astro';
import type {
  CardImage,
  ListPanel,
  SectionCopy,
} from '~/data/types';

/**
 * The two-up band used across the service pages — Before the Code (213:2439),
 * App Types (213:2459), After Launch (213:2488), Where Growth Stalls
 * (233:2277), The Growth Funnel (233:2453), What We Investigate (241:3672) and
 * both Keep Learning sections: a section header over a Card / List beside a
 * Card / Image, closing with an optional row of actions.
 *
 * The action row wraps and centres, because Figma's Keep Learning sections
 * put two buttons here where After Launch puts one.
 */
interface Props {
  copy: SectionCopy;
  panel: ListPanel;
  image: CardImage;
  actions?: CtaAction[];
  id?: string;
}

const { copy, panel, image, actions = [], id }: Props = Astro.props;
---

<section class="list-image" {id}>
  <div class="container list-image__inner">
    <SectionHeader eyebrow={copy.eyebrow} subheading={copy.subheading}>
      {copy.heading}
    </SectionHeader>

    <ul class="card-row">
      <li>
        <ListCard
          tone={panel.tone}
          heading={panel.heading}
          subheading={panel.subheading}
          items={panel.items}
        />
      </li>
      <li>
        <ImageCard
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
        />
      </li>
    </ul>

    {actions.length > 0 && (
      <div class="list-image__actions">
        {actions.map((action) => (
          <LargeButton
            label={action.label}
            href={action.href}
            tone={action.tone ?? 'black'}
          />
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .list-image {
    padding-top: var(--space-4xl);
  }

  .list-image__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .list-image__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs) var(--layout-grid-gap);
  }
</style>
