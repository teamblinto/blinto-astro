---
import Icon from '~/components/ui/Icon.astro';
import { contact, offices } from '~/data/site';

/**
 * The contact page's two-column band: how to reach Blinto directly on the
 * left, the enquiry form on the right.
 *
 * The form is plain HTML and posts on its own — no client JavaScript, so it
 * works before anything hydrates. Where it posts is a build-time setting:
 * `PUBLIC_CONTACT_FORM_ENDPOINT` takes any form backend (Formspree, Web3Forms,
 * a serverless function). With none set, the form falls back to composing a
 * mail in the visitor's own client, so a submission can never vanish into a
 * dead endpoint — and the address is on the page beside it either way.
 */
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
const action = endpoint || `mailto:${contact.email}`;
/* text/plain keeps the mail-client fallback readable; a real backend parses
   the default urlencoded body itself. */
const enctype = endpoint ? undefined : 'text/plain';

const fields: {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel' | 'url';
  placeholder: string;
  required: boolean;
  autocomplete: string;
}[] = [
  { name: 'name', label: 'Full Name', type: 'text', placeholder: 'Enter your name', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', placeholder: 'Enter your email', required: true, autocomplete: 'email' },
  { name: 'phone', label: 'Phone', type: 'tel', placeholder: 'Enter your phone number', required: false, autocomplete: 'tel' },
  { name: 'company', label: 'Company Name', type: 'text', placeholder: 'Type here..', required: false, autocomplete: 'organization' },
  { name: 'website', label: 'Website', type: 'url', placeholder: 'Type here..', required: false, autocomplete: 'url' },
];
---

<section class="contact">
  <div class="container contact__columns">
    <div class="contact__details">
      <h2 class="contact__details-title">Contact Information</h2>

      <a class="contact__email" href={`mailto:${contact.email}`}>
        {contact.email}
      </a>

      <ul class="contact__offices">
        {offices.map((office) => (
          <li class="contact__office">
            <h3 class="contact__office-name">{office.name} Office</h3>
            <p class="contact__office-address">{office.address}</p>
            <a class="contact__office-phone" href={office.phoneHref}>
              {office.phone}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <form class="contact__form form-grid" {action} method="post" {enctype}>
      {fields.map((field) => (
        <p class="field">
          <label class="field__label" for={`contact-${field.name}`}>
            {field.label}
          </label>
          <input
            class="field__control"
            id={`contact-${field.name}`}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            required={field.required}
            autocomplete={field.autocomplete}
          />
        </p>
      ))}

      <p class="field field--wide">
        <label class="field__label" for="contact-message">Message</label>
        <textarea
          class="field__control field__control--area"
          id="contact-message"
          name="message"
          rows="6"
          placeholder="How can we help?"
          required
        ></textarea>
      </p>

      <div class="field--wide">
        <button class="form-submit" type="submit">
          Send Message
          <span class="form-submit__icon">
            <Icon name="arrow-right" size={20} />
          </span>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    padding-top: var(--space-3xl);
  }

  .contact__columns {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2xl) var(--layout-grid-gap);
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    /* The Faq aside's width, so the page keeps one column rhythm. */
    width: var(--layout-aside-width);
    max-width: 100%;
    flex-shrink: 0;
  }

  .contact__details-title {
    /* Heading/Row */
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-1);
    font-weight: var(--font-weight-regular);
    line-height: 1.25;
    text-transform: uppercase;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    /* Body/Subheading */
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    line-height: 1.5;
    color: var(--color-text-brand);
    align-self: flex-start;
  }

  .contact__email:hover {
    text-decoration: underline;
  }

  .contact__offices {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact__office {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-accent-blue);
  }

  .contact__office-name {
    /* Body/Subheading */
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
  }

  .contact__office-address,
  .contact__office-phone {
    /* Body/Answer */
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
  }

  .contact__office-phone {
    align-self: flex-start;
  }

  .contact__office-phone:hover {
    text-decoration: underline;
  }

  .contact__form {
    flex: 1 0 0;
    min-width: min(420px, 100%);
  }

  @media (width <= 900px) {
    .contact__details {
      width: 100%;
    }
  }
</style>
