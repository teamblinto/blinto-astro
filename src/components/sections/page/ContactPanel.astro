---
import Icon from '~/components/ui/Icon.astro';
import { contact, offices } from '~/data/site';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { HONEYPOT_FIELD } from '~/lib/contact-form';

/**
 * The contact page's two-column band: how to reach Blinto directly on the
 * left, the enquiry form on the right.
 *
 * The form posts to `/api/contact/`, the site's one on-demand route, which
 * validates the submission and sends it to the team through Resend. See
 * `src/pages/api/contact.ts`.
 *
 * Three submission paths, in order of what the visitor has available:
 *
 * 1. JavaScript on, everything working — the script below posts with `fetch`
 *    and swaps the result in without leaving the page.
 * 2. JavaScript on, the script or the network failed — the browser falls back
 *    to a native form POST and the endpoint answers with a 303, either to
 *    `/thank-you/` or back here with a reason in the query string.
 * 3. JavaScript off — the form cannot work at all, because Turnstile mints its
 *    token in the browser and the endpoint refuses a submission without one.
 *    Rather than let someone type out an enquiry that is certain to be
 *    rejected, the `<noscript>` block below replaces the form with the email
 *    address. That address is also on the page beside it, unconditionally.
 */

const fields: {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel';
  placeholder: string;
  required: boolean;
  autocomplete: string;
  inputmode?: 'url';
}[] = [
  { name: 'name', label: 'Full Name', type: 'text', placeholder: 'Enter your name', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', placeholder: 'Enter your email', required: true, autocomplete: 'email' },
  { name: 'phone', label: 'Phone', type: 'tel', placeholder: 'Enter your phone number', required: false, autocomplete: 'tel' },
  { name: 'company', label: 'Company Name', type: 'text', placeholder: 'Type here..', required: false, autocomplete: 'organization' },
  /*
    Deliberately `text` rather than `url`. The browser's own `url` validation
    demands a scheme, so `example.com` would be rejected by `reportValidity()`
    before the submission ever left the page. `normaliseWebsite` in
    `src/lib/contact-form.ts` upgrades a bare domain to https and still refuses
    anything that is not http(s), so the check that matters is unchanged;
    `inputmode` keeps the URL-friendly keyboard on a phone.
  */
  { name: 'website', label: 'Website', type: 'text', placeholder: 'Type here..', required: false, autocomplete: 'url', inputmode: 'url' },
];
---

<section class="contact">
  {/*
    The `form` is the two-column container rather than a child of the right
    column, so the Turnstile widget can sit under the office cards on the left
    and still post its `cf-turnstile-response` — the widget writes that hidden
    input into whichever form encloses it, so moving it out of the form would
    silently drop the token. The field grid keeps its own wrapper inside.
  */}
  <form
    class="container contact__columns"
    id="contact-form"
    action="/api/contact/"
    method="post"
    data-contact-form
  >
    <div class="contact__details">
      <h2 class="contact__details-title">Contact Information</h2>

      <a class="contact__email" href={`mailto:${contact.email}`}>
        {contact.email}
      </a>

      <ul class="contact__offices">
        {offices.map((office) => (
          <li class="contact__office">
            <h3 class="contact__office-name">{office.name} Office</h3>
            <p class="contact__office-address">{office.address}</p>
            <a class="contact__office-phone" href={office.phoneHref}>
              {office.phone}
            </a>
          </li>
        ))}
      </ul>

      <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-action="contact"></div>
    </div>

    <div class="contact__form-column">
      <noscript>
        <p class="contact__noscript">
          This form needs JavaScript to verify you are human. With it switched off,
          please email us at <a href={`mailto:${contact.email}`}>{contact.email}</a> and
          we will pick it up the same way.
        </p>
      </noscript>

      <div class="contact__form form-grid">
        {/*
          The honeypot. Hidden from sight, from the accessibility tree and from
          the tab order, and opted out of autofill, so only a bot filling every
          input it finds will put anything here.
        */}
        <div class="contact__honeypot" aria-hidden="true">
          <label for="contact-fax">Fax</label>
          <input
            id="contact-fax"
            name={HONEYPOT_FIELD}
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        {fields.map((field) => (
          <p class="field">
            <label class="field__label" for={`contact-${field.name}`}>
              {field.label}
            </label>
            <input
              class="field__control"
              id={`contact-${field.name}`}
              name={field.name}
              type={field.type}
              placeholder={field.placeholder}
              required={field.required}
              autocomplete={field.autocomplete}
              inputmode={field.inputmode}
              aria-describedby={`contact-${field.name}-error`}
            />
            <span class="field__error" id={`contact-${field.name}-error`} data-error-for={field.name}></span>
          </p>
        ))}

        <p class="field field--wide">
          <label class="field__label" for="contact-message">Message</label>
          <textarea
            class="field__control field__control--area"
            id="contact-message"
            name="message"
            rows="6"
            placeholder="How can we help?"
            required
            aria-describedby="contact-message-error"
          ></textarea>
          <span class="field__error" id="contact-message-error" data-error-for="message"></span>
        </p>

        <div class="field--wide contact__actions">
          <button class="form-submit" type="submit" data-submit>
            <span data-submit-label>Send Message</span>
            <span class="form-submit__icon">
              <Icon name="arrow-right" size={20} />
            </span>
          </button>
        </div>

        {/*
          Announced rather than merely shown, so the result of a submission
          reaches a screen reader without moving focus mid-typing.
        */}
        <p class="contact__status field--wide" role="status" aria-live="polite" data-status hidden></p>
      </div>
    </div>
  </form>
</section>

<script
  is:inline
  async
  defer
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
></script>

<script>
  /**
   * Progressive enhancement for the contact form. Without this the form still
   * posts natively and the endpoint answers with a redirect; with it, the
   * visitor stays on the page and sees per-field errors.
   */
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const idleLabel = submitLabel?.textContent ?? 'Send Message';

    const errorFor = (field: string) =>
      form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);

    const setStatus = (message: string, tone: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.tone = tone;
      status.hidden = false;
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((slot) => {
        slot.textContent = '';
        const field = slot.dataset.errorFor;
        if (!field) return;
        form.querySelector(`[name="${field}"]`)?.removeAttribute('aria-invalid');
      });
    };

    const showErrors = (errors: Record<string, string>) => {
      let first: HTMLElement | null = null;
      for (const [field, message] of Object.entries(errors)) {
        const slot = errorFor(field);
        if (slot) slot.textContent = message;
        const control = form.querySelector<HTMLElement>(`[name="${field}"]`);
        if (control) {
          control.setAttribute('aria-invalid', 'true');
          if (!first) first = control;
        }
      }
      // Send focus to the first thing that needs fixing, so a keyboard user is
      // not left hunting for it.
      first?.focus();
    };

    /**
     * A used Turnstile token cannot be verified twice, so the widget has to be
     * reset before the visitor can try again after any failure.
     */
    const resetChallenge = () => {
      const turnstile = (window as unknown as { turnstile?: { reset: () => void } }).turnstile;
      try {
        turnstile?.reset();
      } catch {
        /* The widget may not have loaded; the next submit will say so. */
      }
    };

    form.addEventListener('submit', async (event) => {
      // Let the browser run its own required/type validation first.
      if (!form.reportValidity()) return;

      event.preventDefault();
      clearErrors();

      if (submit) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });

        const result = (await response.json()) as {
          ok: boolean;
          message: string;
          errors?: Record<string, string>;
        };

        if (result.ok) {
          form.reset();
          resetChallenge();
          setStatus(result.message, 'success');
          return;
        }

        resetChallenge();
        setStatus(result.message, 'error');
        if (result.errors) showErrors(result.errors);
      } catch {
        // The request never completed. Submitting natively hands the problem to
        // the browser, which will report it in a way the visitor can act on.
        resetChallenge();
        form.submit();
      } finally {
        if (submit) submit.disabled = false;
        if (submitLabel) submitLabel.textContent = idleLabel;
      }
    });

    /**
     * The native-POST fallback bounces back here with a reason. Only reachable
     * when JavaScript is running, which is exactly when this can render it.
     */
    const params = new URLSearchParams(window.location.search);
    if (params.get('status') === 'error') {
      const reasons: Record<string, string> = {
        invalid: 'Please check the highlighted fields and try again.',
        challenge: 'We could not verify that you are human. Please try again.',
        'rate-limited': 'That is a lot of messages in a short time. Please wait a minute.',
        'send-failed':
          'Something went wrong sending your message. Please try again, or email hello@blinto.co.',
        unavailable:
          'The contact form is temporarily unavailable. Please email hello@blinto.co.',
      };
      setStatus(reasons[params.get('reason') ?? ''] ?? 'Something went wrong. Please try again.', 'error');
    }
  }
</script>

<style>
  .contact {
    padding-top: var(--space-3xl);
  }

  .contact__columns {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2xl) var(--layout-grid-gap);
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    /* The Faq aside's width, so the page keeps one column rhythm. */
    width: var(--layout-aside-width);
    max-width: 100%;
    flex-shrink: 0;
  }

  .contact__details-title {
    /* Heading/Row */
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-1);
    font-weight: var(--font-weight-regular);
    line-height: 1.25;
    text-transform: uppercase;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    /* Body/Subheading */
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    line-height: 1.5;
    color: var(--color-text-brand);
    align-self: flex-start;
  }

  .contact__email:hover {
    text-decoration: underline;
  }

  .contact__offices {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact__office {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-accent-blue);
  }

  .contact__office-name {
    /* Body/Subheading */
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
  }

  .contact__office-address,
  .contact__office-phone {
    /* Body/Answer */
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
  }

  .contact__office-phone {
    align-self: flex-start;
  }

  .contact__office-phone:hover {
    text-decoration: underline;
  }

  .contact__form-column {
    flex: 1 0 0;
    min-width: min(420px, 100%);
  }

  .contact__form {
    width: 100%;
  }

  /*
    Off-screen rather than `display: none`: some bots skip inputs that are not
    rendered, and the point is for them to find it and fill it in.
  */
  .contact__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .contact__noscript {
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-accent-blue);
    font-size: var(--font-size-body-sm);
    line-height: 1.5;
  }

  .contact__noscript a {
    color: var(--color-text-brand);
    text-decoration: underline;
  }

  .field__error:empty {
    display: none;
  }

  .field__error {
    display: block;
    margin-top: var(--space-3xs);
    font-size: var(--font-size-body-sm);
    line-height: 1.4;
    color: #b3261e;
  }

  .contact__status {
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--font-size-body-sm);
    line-height: 1.5;
  }

  .contact__status[data-tone='success'] {
    background-color: var(--color-bg-accent-blue);
  }

  .contact__status[data-tone='error'] {
    background-color: #fdeceb;
    color: #b3261e;
  }

  /*
    The widget is a fixed 300px wide, so it is left at its natural width rather
    than stretched across the column. It sits below the last office card, which
    keeps the form short enough for the submit button and the status message to
    land in the viewport together.
  */
  .contact__details :global(.cf-turnstile) {
    align-self: flex-start;
  }

  @media (width <= 900px) {
    .contact__details {
      width: 100%;
    }
  }
</style>
