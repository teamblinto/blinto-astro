---
import { Image } from 'astro:assets';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import LargeButton from '~/components/ui/LargeButton.astro';
import type { CtaAction } from '~/components/sections/Cta.astro';
import type { CardImage } from '~/data/types';

/**
 * Section / Hero (Figma 217:3139) — the service-page hero: a Split Compact
 * section header, an action row, and a full-bleed banner.
 *
 * The banner sits outside the page margin in Figma (x=0, w=1440 against a
 * 1440 frame) while the header keeps it, so the banner is edge-to-edge and
 * only the header is in the container.
 */
interface Props {
  eyebrow: string;
  heading: string;
  subheading: string;
  actions: CtaAction[];
  banner: CardImage;
}

const { eyebrow, heading, subheading, actions, banner }: Props = Astro.props;

/** See ImageCard: never ask for a 2x that the export cannot actually supply. */
const bannerDensities = banner.src.width >= banner.width * 2 ? [1, 2] : [1];
---

<section class="service-hero">
  <div class="container service-hero__header">
    <SectionHeader {eyebrow} {subheading} as="h1" compact>
      {heading}
    </SectionHeader>

    <div class="service-hero__actions">
      {actions.map((action) => (
        <LargeButton
          label={action.label}
          href={action.href}
          tone={action.tone ?? 'black'}
        />
      ))}
    </div>
  </div>

  <Image
    class="service-hero__banner"
    src={banner.src}
    alt={banner.alt}
    width={banner.width}
    height={banner.height}
    densities={bannerDensities}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</section>

<style>
  .service-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xl);
    padding-top: var(--space-3xl);
  }

  .service-hero__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xl);
  }

  .service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--layout-grid-gap);
    width: 100%;
  }

  .service-hero__banner {
    width: 100%;
    /* Figma pins the banner to 800 tall at 1440 wide; below that it keeps the
       same 9:5 crop rather than growing taller than the viewport. */
    height: auto;
    aspect-ratio: 1440 / 800;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background-color: var(--color-border-faint);
  }
</style>
