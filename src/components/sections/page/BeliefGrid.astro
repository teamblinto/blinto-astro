---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import BeliefCard from '~/components/ui/BeliefCard.astro';
import ImageCard from '~/components/ui/ImageCard.astro';
import type { BeliefCell, SectionCopy } from '~/data/types';

/**
 * The belief grid: a section header over a grid of Card / Belief cells, some
 * of which Figma swaps for a Card / Image photo tile. Serves What We Build
 * (213:2450), What We Do (233:2424, 241:3643), Why Blinto (×3), and on the
 * About page both How We Think (253:4988, 4-up heading-only cards) and How We
 * Work (254:4981, all photo tiles).
 *
 * Each card carries its own height, so a row of shorter cards just passes a
 * smaller `cellMinHeight`; `cardMin` narrows the column so a row can go 4-up
 * rather than 3-up.
 */
interface Props {
  copy: SectionCopy;
  cells: BeliefCell[];
  /** Column floor. Default is `--layout-card-min` (330). */
  cardMin?: number;
  /** Card / Belief min-height. Figma's default is 320. */
  cellMinHeight?: number;
}

const { copy, cells, cardMin, cellMinHeight }: Props = Astro.props;
---

<section class="belief-grid">
  <div class="container belief-grid__inner">
    <SectionHeader eyebrow={copy.eyebrow} subheading={copy.subheading}>
      {copy.heading}
    </SectionHeader>

    <ul
      class="card-grid"
      style={cardMin ? `--layout-card-min: ${cardMin}px` : undefined}
    >
      {cells.map((cell) => (
        <li>
          {cell.kind === 'image' ? (
            <ImageCard
              src={cell.image.src}
              alt={cell.image.alt}
              width={cell.image.width}
              height={cell.image.height}
            />
          ) : (
            <BeliefCard
              tone={cell.tone}
              heading={cell.heading}
              body={cell.body}
              minHeight={cellMinHeight}
            />
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .belief-grid {
    padding-top: var(--space-4xl);
  }

  .belief-grid__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

</style>
