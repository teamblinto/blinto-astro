---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import ArticleCard from '~/components/ui/ArticleCard.astro';
import LargeButton from '~/components/ui/LargeButton.astro';
import type { CtaAction } from '~/components/sections/Cta.astro';
import type { ArticleTile, SectionCopy } from '~/data/types';

/**
 * Section / Latest (Figma 332:8421) and Section / Related (338:8652) — the
 * same section in both places: a Split Compact header over a wrapping grid of
 * Card / Article, with an optional centred action beneath it.
 *
 * The grid is `.card-grid`, so it goes three across at 1440, two, then one,
 * exactly as the tablet and mobile frames do. One card is the exception —
 * see `.card-grid--lone` below.
 */
interface Props {
  /**
   * The section header. Omitted on a topic page, whose hero already names the
   * topic — a second heading saying the same thing twice is worse than none.
   */
  copy?: SectionCopy;
  articles: ArticleTile[];
  /** Centred beneath the grid — the design's "Load More Articles". */
  action?: CtaAction;
  id?: string;
  /** Heading level for the cards, which sit under this section's heading. */
  cardHeading?: 'h2' | 'h3';
}

const { copy, articles, action, id, cardHeading = 'h3' }: Props = Astro.props;
---

<section class="articles" {id}>
  <div class="container articles__inner">
    {copy && (
      <SectionHeader eyebrow={copy.eyebrow} subheading={copy.subheading} compact>
        {copy.heading}
      </SectionHeader>
    )}

    <ul class:list={['card-grid', articles.length === 1 && 'card-grid--lone']}>
      {articles.map((article) => (
        <li>
          <ArticleCard
            headline={article.headline}
            excerpt={article.excerpt}
            href={article.href}
            category={article.category}
            readTime={article.readTime}
            tone={article.tone}
            cover={article.cover}
            coverAlt={article.coverAlt}
            as={cardHeading}
          />
        </li>
      ))}
    </ul>

    {action && (
      <div class="articles__action">
        <LargeButton
          label={action.label}
          href={action.href}
          tone={action.tone ?? 'outline'}
        />
      </div>
    )}
  </div>
</section>

<style>
  .articles {
    padding-top: var(--space-4xl);
    scroll-margin-top: var(--space-xl);
  }

  .articles__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  /**
   * A row holding a single card.
   *
   * `.card-grid` sizes its tracks with `auto-fit`, which collapses the tracks
   * it cannot fill — so one card on its own stretches the full 1320 and comes
   * out a wholly different shape from the card the design draws. `auto-fill`
   * keeps those empty tracks, leaving the card at its own width with the rest
   * of the row blank, which is what a blog with one post should look like.
   *
   * Only this section opts in: elsewhere a lone card filling its row is the
   * intended behaviour, so `.card-grid` itself is left alone.
   */
  .card-grid--lone {
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(var(--layout-card-min), 100%), 1fr)
    );
  }

  .articles__action {
    display: flex;
    justify-content: center;
  }
</style>
