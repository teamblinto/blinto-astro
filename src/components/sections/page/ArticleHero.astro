---
import { Image } from 'astro:assets';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import ArticleMeta from '~/components/ui/ArticleMeta.astro';

/**
 * Section / Hero on Blog Post · Desktop (Figma 335:8630).
 *
 * Centred, unlike every other hero on the site: the eyebrow, the
 * Display/Feature headline capped at 1000, the standfirst capped at 820 and
 * the byline all sit on the page's centre line, then the cover runs the full
 * content width beneath them.
 */
interface Props {
  category: string;
  categoryHref: string;
  headline: string;
  standfirst: string;
  author: string;
  dateLabel: string;
  /** The same date as `YYYY-MM-DD`, for the `<time>` element. */
  dateIso: string;
  readTime: string;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const {
  category,
  categoryHref,
  headline,
  standfirst,
  author,
  dateLabel,
  dateIso,
  readTime,
  cover,
  coverAlt,
}: Props = Astro.props;

/* The cover is 1320x520 at 1440. See ImageCard on density. */
const SLOT_WIDTH = 1320;
const SLOT_HEIGHT = 520;
const densities = cover && cover.width >= SLOT_WIDTH * 2 ? [1, 2] : [1];
---

<section class="article-hero">
  <div class="container article-hero__header">
    <a class="article-hero__topic" href={categoryHref}>
      <Eyebrow label={category} />
    </a>

    <h1 class="article-hero__headline">{headline}</h1>
    <p class="article-hero__standfirst">{standfirst}</p>

    <ArticleMeta
      lead={`By ${author}`}
      rest={[{ text: dateLabel, dateTime: dateIso }, readTime]}
      class="article-hero__byline"
    />
  </div>

  <div class="container">
    <div class="article-hero__slot">
      {cover ? (
        <Image
          class="article-hero__cover"
          src={cover}
          alt={coverAlt ?? ''}
          width={SLOT_WIDTH}
          height={SLOT_HEIGHT}
          {densities}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <p class="article-hero__note">Cover image</p>
      )}
    </div>
  </div>
</section>

<style>
  .article-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    padding-top: var(--space-3xl);
  }

  .article-hero__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .article-hero__topic {
    display: inline-flex;
  }

  .article-hero__headline {
    /* Display/Feature */
    font-family: var(--font-family-display);
    font-size: var(--font-size-display-3);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    text-transform: uppercase;
    /* Figma pins the headline to 1000 and the standfirst to 820. */
    max-width: 1000px;
  }

  .article-hero__standfirst {
    /* Body/Lead */
    font-size: var(--font-size-body-lg);
    line-height: 1.4;
    max-width: 820px;
  }

  .article-hero__byline {
    justify-content: center;
  }

  .article-hero__slot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 520px;
    overflow: hidden;
    background-color: var(--color-bg-accent-blue);
    border: 1px solid var(--color-border-faint);
    border-radius: var(--radius-lg);
  }

  .article-hero__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-hero__note {
    /* Body/Default at 50% — Figma's pending-note treatment. */
    font-size: var(--font-size-body-xs);
    opacity: 0.5;
  }

  /* The tablet frame drops the cover to 340 and the mobile frame to 200. */
  @media (width <= 900px) {
    .article-hero__slot {
      height: 340px;
    }
  }

  @media (width <= 600px) {
    .article-hero__slot {
      height: 200px;
    }
  }
</style>
