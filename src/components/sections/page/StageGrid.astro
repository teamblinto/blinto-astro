---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import FeatureCard from '~/components/ui/FeatureCard.astro';
import type { SectionCopy, StageCard } from '~/data/types';

/**
 * The Card / Feature grid without its tick list — Where You Are (213:2444),
 * Support Models (242:3672) and the About page's What We Do (253:4836).
 * A card with no `cta` is Figma's Show button=false short stage card; About
 * sets one, which adds the outline pill at the foot of each card.
 */
interface Props {
  copy: SectionCopy;
  cards: StageCard[];
}

const { copy, cards }: Props = Astro.props;
---

<section class="stage-grid">
  <div class="container stage-grid__inner">
    <SectionHeader eyebrow={copy.eyebrow} subheading={copy.subheading}>
      {copy.heading}
    </SectionHeader>

    <ul class="card-grid">
      {cards.map((card) => (
        <li>
          <FeatureCard
            icon={card.icon}
            tone={card.tone}
            heading={card.heading}
            body={card.body}
            cta={card.cta}
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stage-grid {
    padding-top: var(--space-4xl);
  }

  .stage-grid__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }
</style>
