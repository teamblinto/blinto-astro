---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import ProductCard from '~/components/ui/ProductCard.astro';
import type { ProductTile, SectionCopy } from '~/data/types';

/**
 * Section / Product Tour (Figma 270:6161) — a row of Card / Product tiles.
 */
interface Props {
  copy: SectionCopy;
  products: ProductTile[];
  /** Column floor. Default is `--layout-card-min` (330). */
  cardMin?: number;
  id?: string;
}

const { copy, products, cardMin, id }: Props = Astro.props;
---

<section class="products" {id}>
  <div class="container products__inner">
    <SectionHeader eyebrow={copy.eyebrow} subheading={copy.subheading}>
      {copy.heading}
    </SectionHeader>

    <ul
      class="card-grid"
      style={cardMin ? `--layout-card-min: ${cardMin}px` : undefined}
    >
      {products.map((product) => (
        <li>
          <ProductCard
            name={product.name}
            description={product.description}
            tone={product.tone}
            screenshot={product.screenshot}
            note={product.note}
            cta={product.cta}
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .products {
    padding-top: var(--space-4xl);
    scroll-margin-top: var(--space-xl);
  }

  .products__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }
</style>
