---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import { faqs } from '~/data/home';

/**
 * Section / FAQ (Figma 149:266) with FAQ Item (131:79) — "Accordion row.
 * State=Expanded reveals the answer and swaps the plus for a minus. White
 * interior with a grey/100 hairline outline; the toggle column's left edge
 * forms the internal rule."
 *
 * Built on <details>/<summary> so it works with no JavaScript and gets
 * keyboard support and correct semantics from the platform. The first row is
 * open, matching the design. The plus/minus glyph is drawn with two spans
 * rather than swapped icons so it can animate.
 */
---

<section class="faq">
  <div class="container faq__columns">
    <div class="faq__aside">
      <SectionHeader layout="stacked" eyebrow="FAQs" subheading="Here's what most teams want to know before they reach out.">
        Questions App Teams Ask Before Choosing a Shopify Expert Agency
      </SectionHeader>
    </div>

    <div class="faq__list">
      {faqs.map((faq, index) => (
        <details class="faq__item" open={index === 0} name="blinto-faq">
          <summary class="faq__summary">
            <span class="faq__question">{faq.question}</span>
            <span class="faq__toggle">
              <span class="faq__glyph" aria-hidden="true"></span>
            </span>
          </summary>
          <div class="faq__answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding-top: var(--space-4xl);
  }

  .faq__columns {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2xl) var(--space-md);
  }

  .faq__aside {
    /* Figma: a 538px aside beside the list. */
    width: var(--layout-aside-width);
    max-width: 100%;
    flex-shrink: 0;
  }

  .faq__list {
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    gap: var(--space-md);
    min-width: min(420px, 100%);
    /* Figma drops the list 60px so row one aligns with the heading. */
    padding-top: var(--space-3xl);
  }

  .faq__item {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-page);
    border: 1px solid var(--color-border-faint);
  }

  .faq__summary {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--space-md);
    cursor: pointer;
    list-style: none;
  }

  /* Suppress the native disclosure triangle in every engine. */
  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__summary::marker {
    content: '';
  }

  .faq__question {
    flex: 1 0 0;
    min-width: 0;
    padding: var(--space-lg) var(--space-md);
    /* Heading/Row */
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-2);
    font-weight: var(--font-weight-regular);
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  /* The toggle column's left edge forms the internal rule. */
  .faq__toggle {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-shrink: 0;
    width: 88px;
    padding-block: var(--space-lg);
    border-left: 1px solid var(--color-border-faint);
    color: var(--color-icon-primary);
  }

  /* A 32px plus that loses its vertical bar when the row expands. */
  .faq__glyph {
    position: relative;
    width: 32px;
    height: 32px;
  }

  .faq__glyph::before,
  .faq__glyph::after {
    content: '';
    position: absolute;
    inset: 50% 16.67%;
    border-top: 1.5px solid currentColor;
  }

  .faq__glyph::after {
    transform: rotate(90deg);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .faq__item[open] .faq__glyph::after {
    opacity: 0;
    transform: rotate(0deg);
  }

  .faq__answer {
    /* Line the answer up with the question's text column, and keep it clear
       of the toggle rule. */
    padding: 0 calc(88px + var(--space-md)) var(--space-lg) var(--space-md);
  }

  .faq__answer p {
    /* Body/Answer */
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .faq__summary:hover .faq__question {
    color: var(--color-text-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__glyph::after {
      transition: none;
    }
  }

  @media (width <= 900px) {
    .faq__aside {
      width: 100%;
    }

    .faq__answer {
      padding-right: var(--space-md);
    }

    .faq__list {
      padding-top: 0;
    }
  }
</style>
