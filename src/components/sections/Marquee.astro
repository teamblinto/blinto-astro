---
import { marqueeItems } from '~/data/home';

/**
 * Marquee (Figma 135:135) — "Full-bleed scrolling statement band. Text is
 * centred and deliberately overflows a clipping frame, so it bleeds at every
 * breakpoint. Top and bottom hairlines only."
 *
 * Figma pins a static overflowing line; the component description calls it a
 * "scrolling statement band", so it scrolls here — continuously, with no
 * visible seam.
 *
 * How the seamless loop works: the track holds exactly TWO identical groups
 * and animates from 0 to -50%, so the moment the first group has fully exited
 * the second sits precisely where the first began. The shift only lands on an
 * item boundary if each group's width includes its own trailing gap, which is
 * why the gap is applied as `padding-inline-end` on the group rather than as a
 * `gap` on the track — a track-level gap would leave the translation half a
 * gap short and the loop would visibly jump.
 *
 * Each group repeats the phrase list twice so the track stays wider than the
 * viewport on ultrawide displays, where a single pass would otherwise scroll
 * a blank stretch into view.
 */
const REPEATS_PER_GROUP = 2;

const groupItems = Array.from({ length: REPEATS_PER_GROUP }, () => marqueeItems).flat();

/** Two passes: the first is read out, the second is purely visual. */
const groups = [false, true];
---

<div class="marquee">
  <div class="marquee__track">
    {groups.map((isDuplicate) => (
      <div class="marquee__group" aria-hidden={isDuplicate ? 'true' : undefined}>
        {groupItems.map((item) => (
          <span class="marquee__item">
            <span class="marquee__bullet" aria-hidden="true">&bull;</span>
            {item}
          </span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    display: flex;
    align-items: center;
    height: 112px;
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    overflow: hidden;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 48s linear infinite;
    /* Promote once so the transform does not repaint the band every frame. */
    will-change: transform;
  }

  .marquee__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2xl);
    /* Carries the seam gap, so the group's width is its full repeat length. */
    padding-inline-end: var(--space-2xl);
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xl);
    /* Display/Marquee */
    font-family: var(--font-family-display);
    font-size: var(--font-size-display-4);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .marquee__bullet {
    color: var(--color-icon-brand);
  }

  /* Two identical groups, so -50% is exactly one group's advance. */
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Hovering pauses the band so a reader can finish a phrase. */
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      will-change: auto;
      /* Centre the single remaining pass, as the static design has it. */
      margin-inline: auto;
    }

    .marquee__group[aria-hidden='true'] {
      display: none;
    }

    .marquee__group {
      padding-inline-end: 0;
    }
  }
</style>
