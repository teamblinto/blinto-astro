---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import FeatureCard from '~/components/ui/FeatureCard.astro';
import { stageCards } from '~/data/home';

/** Section / Where You Are (Figma 148:48). */
---

<section class="stages">
  <div class="container stages__inner">
    <SectionHeader eyebrow="Where You Are" subheading="Some teams are shaping an idea. Others are chasing growth or keeping a live app running. Blinto meets you where you are.">
      Every Shopify App Journey Starts at a Different Stage
    </SectionHeader>

    <ul class="card-grid">
      {stageCards.map((card) => (
        <li>
          <FeatureCard
            icon={card.icon}
            tone={card.tone}
            heading={card.heading}
            body={card.body}
            cta={card.cta}
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stages {
    padding-top: var(--space-4xl);
  }

  .stages__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }
</style>
