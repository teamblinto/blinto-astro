---
/**
 * Button (Figma 54:1466) — "Secondary outline pill button used inside cards.
 * State=Hover fills brand blue."
 */
interface Props {
  label: string;
  href?: string;
  tone?: 'outline' | 'brand' | 'inverse';
  class?: string;
}

const { label, href = '#contact', tone = 'outline', class: className } = Astro.props;
---

<a href={href} class:list={['pill-button', `pill-button--${tone}`, className]}>
  <span class="pill-button__label">{label}</span>
</a>

<style>
  .pill-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    height: 48px;
    padding: var(--space-2xs) var(--space-md);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    /* Label/Button */
    font-family: var(--font-family-body);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .pill-button__label {
    /* Figma caps the label wrap at 420 so long CTAs stay on one or two lines. */
    max-width: 420px;
  }

  .pill-button--outline {
    border-color: var(--color-border-default);
    color: var(--color-text-primary);
  }

  /* State=Hover fills brand blue. */
  .pill-button--outline:hover {
    background-color: var(--color-bg-brand);
    border-color: var(--color-bg-brand);
    color: var(--color-text-inverse);
  }

  .pill-button--brand {
    background-color: var(--color-bg-brand);
    border-color: var(--color-bg-brand);
    color: var(--color-text-inverse);
  }

  .pill-button--brand:hover {
    background-color: var(--color-bg-inverse);
    border-color: var(--color-bg-inverse);
  }

  .pill-button--inverse {
    border-color: var(--color-border-inverse-subtle);
    color: var(--color-text-inverse);
  }

  .pill-button--inverse:hover {
    background-color: var(--color-bg-page);
    border-color: var(--color-bg-page);
    color: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .pill-button {
      transition: none;
    }
  }
</style>
