---
/**
 * Blinto logo — exported verbatim from Figma node 61:4323 via the Plugin API.
 *
 * Both the quatrefoil mark and the "blinto" wordmark are real vector paths, so
 * the wordmark is the drawn logotype rather than text set in a body face. The
 * design's literal `white` fills are swapped for `currentColor` so one file
 * serves the blue nav mark and the white footer mark.
 */
interface Props {
  /** `brand` paints the logo in Blinto blue, `inverse` in white. */
  tone?: 'brand' | 'inverse';
  /** Rendered height in px. Figma pins 48 in both the nav and the footer. */
  height?: number;
  href?: string | null;
}

const { tone = 'brand', height = 48, href = '/' }: Props = Astro.props;

const Tag = href ? 'a' : 'span';
