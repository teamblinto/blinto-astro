<style>
  .logo {
    display: inline-flex;
    align-items: center;
    height: var(--logo-height);
  }

  .logo--brand {
    color: var(--color-text-brand);
  }

  .logo--inverse {
    color: var(--color-text-inverse);
  }

  /* Figma pins the lockup at 161x48; the aspect ratio holds at any height. */
  .logo__svg {
    height: var(--logo-height);
    width: auto;
  }
</style>
