---
import type { CardTone } from './FeatureCard.astro';

/**
 * Card / Belief (Figma 130:144) — "Statement card for belief / principle
 * grids. Title pinned top, copy pinned bottom via space-between over a 320
 * min-height. Show body=false gives a heading-only statement card."
 *
 * Omit `body` for that heading-only variant: the heading then centres in the
 * card rather than being pushed against a body that isn't there. The About
 * page's How We Think grid uses it over a shorter 200 min-height.
 */
interface Props {
  tone: CardTone;
  heading: string;
  body?: string;
  /** Figma's 320 default; How We Think (253:4998) pins its row to 200. */
  minHeight?: number;
  /** Heading level for the card title, to keep the outline sane. */
  as?: 'h3' | 'h4';
}

const {
  tone,
  heading,
  body,
  minHeight = 320,
  as: Heading = 'h3',
}: Props = Astro.props;
---

<article
  class:list={[
    'belief-card',
    `belief-card--${tone}`,
    !body && 'belief-card--heading-only',
  ]}
  style={`--belief-card-min-height: ${minHeight}px`}
>
  <Heading class="belief-card__heading">{heading}</Heading>
  {body && <p class="belief-card__body">{body}</p>}
</article>

<style>
  .belief-card {
    display: flex;
    flex-direction: column;
    /* Heading top, body bottom. */
    justify-content: space-between;
    gap: var(--space-xl);
    width: 100%;
    min-height: var(--belief-card-min-height);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
  }

  .belief-card--blue {
    background-color: var(--color-bg-accent-blue);
  }

  .belief-card--yellow {
    background-color: var(--color-bg-accent-yellow);
  }

  .belief-card--green {
    background-color: var(--color-bg-accent-green);
  }

  .belief-card__heading {
    /* Heading/Card */
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-1);
    font-weight: var(--font-weight-regular);
    line-height: 1.25;
    text-transform: uppercase;
    margin: 0;
  }

  /* Nothing to push the heading away from, so centre it instead. */
  .belief-card--heading-only {
    justify-content: center;
  }

  .belief-card__body {
    /* Body/Default */
    font-size: var(--font-size-body-xs);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
  }
</style>
