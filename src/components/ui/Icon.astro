---
/**
 * Icon set — exported verbatim from the Figma file via the Plugin API
 * (`exportAsync({ format: 'SVG_STRING' })`), then normalised:
 *
 * - the design's literal `#222222` / `white` strokes and fills become
 *   `currentColor`, so an icon takes its colour from context;
 * - each icon keeps its own Figma `viewBox`, so geometry is exact rather than
 *   refitted to a common grid;
 * - coordinates are rounded to 2dp (these render at <= 48px).
 *
 * Brand-coloured artwork (the Shopify bag) keeps its real palette — those
 * colours identify the brand and must not follow the surrounding text.
 *
 * Node IDs are recorded per icon so any of these can be re-exported.
 */
export type IconName =
  | 'caret-down'
  | 'arrow-right'
  | 'menu'
  | 'close'
  | 'plus'
  | 'minus'
  | 'check'
  | 'facebook'
  | 'instagram'
  | 'linkedin'
  | 'x'
  | 'youtube'
  | 'shopify-bag'
  | 'idea'
  | 'growth'
  | 'support'
  | 'launch'
  | 'admin'
  | 'updates';

interface Props {
  name: IconName;
  /**
   * Edge length. A number is px; a string is used verbatim, so an icon can be
   * sized against its surrounding type (e.g. `"0.78em"`). Always set it
   * explicitly — never rely on a default.
   */
  size: number | string;
  class?: string;
  /**
   * Decorative by default. Pass a label when the icon is the only content of
   * an interactive element and nothing else names it.
   */
  label?: string;
}

type IconDef = { viewBox: string; body: string };

const S = 'stroke="currentColor"';
const F = 'fill="currentColor"';

