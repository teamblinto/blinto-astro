---
/**
 * Inline icon set.
 *
 * Icons render inline (not via <img>) so they inherit `currentColor` and stay
 * crisp at any size, and so the page makes no extra requests for them.
 *
 * NOTE: Figma's exported icon SVGs were unreachable in this environment (see
 * README "Design assets"), so these glyphs are authored to match the design
 * renders. `region-us` / `region-bd` are explicit stand-ins for the two
 * illustrated map silhouettes in the footer.
 */
export type IconName =
  | 'caret-down'
  | 'arrow-right'
  | 'menu'
  | 'close'
  | 'plus'
  | 'check'
  | 'facebook'
  | 'instagram'
  | 'linkedin'
  | 'x'
  | 'youtube'
  | 'idea'
  | 'launch'
  | 'system'
  | 'maintain'
  | 'growth'
  | 'support'
  | 'shopify-bag'
  | 'region-us'
  | 'region-bd';

interface Props {
  name: IconName;
  /**
   * Edge length. A number is px; a string is used verbatim, so an icon can be
   * sized against its surrounding type (e.g. `"0.78em"`). Always set it
   * explicitly — never rely on a default.
   */
  size: number | string;
  class?: string;
  /**
   * Decorative by default. Pass a label when the icon is the only content of
   * an interactive element and nothing else names it.
   */
  label?: string;
}

const { name, size, class: className, label }: Props = Astro.props;

const length = typeof size === 'number' ? `${size}px` : size;
/** Only a px size can seed the intrinsic width/height attributes. */
const intrinsic = typeof size === 'number' ? size : undefined;

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true', focusable: 'false' } as const);
---

<svg
  class:list={['icon', className]}
  width={intrinsic}
  height={intrinsic}
  viewBox="0 0 24 24"
  fill="none"
  style={`--icon-size: ${length}`}
  {...a11y}
>
  {name === 'caret-down' && (
    <path d="M6 9.5 12 15.5 18 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  )}

  {name === 'arrow-right' && (
    <>
      <path d="M4.5 12h15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <path d="M13 5.5 19.5 12 13 18.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}

  {name === 'menu' && (
    <path d="M3.5 7h17M3.5 12h17M3.5 17h17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  )}

  {name === 'close' && (
    <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  )}

  {name === 'plus' && (
    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  )}

  {name === 'check' && (
    <path d="M4.5 12.5 9.5 17.5 19.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  )}

  {name === 'facebook' && (
    <path
      d="M13.2 21v-8h2.6l.4-3h-3V8.2c0-.9.25-1.5 1.5-1.5H16.3V4a20 20 0 0 0-2.2-.1c-2.2 0-3.7 1.35-3.7 3.85V10H7.8v3h2.6v8z"
      fill="currentColor"
    />
  )}

  {name === 'instagram' && (
    <>
      <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" stroke="currentColor" stroke-width="1.8" />
      <circle cx="12" cy="12" r="4.1" stroke="currentColor" stroke-width="1.8" />
      <circle cx="17.1" cy="6.9" r="1.2" fill="currentColor" />
    </>
  )}

  {name === 'linkedin' && (
    <>
      <path d="M4.6 9.4h2.9V20H4.6zM6.05 4a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4" fill="currentColor" />
      <path
        d="M10.1 9.4H13v1.45a3.2 3.2 0 0 1 2.87-1.6c2.3 0 3.63 1.45 3.63 4.2V20h-2.9v-6.05c0-1.45-.55-2.2-1.7-2.2-1.05 0-1.9.7-1.9 2.3V20h-2.9z"
        fill="currentColor"
      />
    </>
  )}

  {name === 'x' && (
    <path
      d="M4 4h4.3l4.05 5.5L16.9 4H20l-6.05 7.35L20.4 20h-4.3l-4.3-5.8L6.9 20H3.8l6.3-7.6z"
      fill="currentColor"
    />
  )}

  {name === 'youtube' && (
    <>
      <rect x="2.6" y="5.4" width="18.8" height="13.2" rx="4" stroke="currentColor" stroke-width="1.8" />
      <path d="M10.5 9.4 15.4 12l-4.9 2.6z" fill="currentColor" />
    </>
  )}

  {name === 'launch' && (
    <>
      <path
        d="M12 2.6c2.35 2.2 3.6 5.1 3.6 8.35v3.7H8.4v-3.7c0-3.25 1.25-6.15 3.6-8.35"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
      />
      <circle cx="12" cy="9.6" r="2.1" stroke="currentColor" stroke-width="1.7" />
      <path
        d="M8.4 12.4 5.6 15v3.3h2.8M15.6 12.4 18.4 15v3.3h-2.8"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M10.4 20.2c.5.8 1.05 1.2 1.6 1.2s1.1-.4 1.6-1.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    </>
  )}

  {name === 'system' && (
    <>
      <path
        d="M12 2.7 20.2 5.6v6.05c0 4.3-2.85 8.15-8.2 9.65-5.35-1.5-8.2-5.35-8.2-9.65V5.6z"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
      />
      <path d="M12 3.2v18M4.1 12h15.8" stroke="currentColor" stroke-width="1.7" />
    </>
  )}

  {name === 'maintain' && (
    <>
      <circle cx="12" cy="12" r="3.1" stroke="currentColor" stroke-width="1.7" />
      <path
        d="M12 2.6c.66 0 1.3.06 1.92.18l.35 2.06a7.5 7.5 0 0 1 1.9 1.1l1.96-.72c.44.47.84.98 1.18 1.53l-1.28 1.65c.3.63.52 1.3.65 2l1.97.72a9.6 9.6 0 0 1 0 1.9l-1.97.72c-.13.7-.35 1.37-.65 2l1.28 1.65c-.34.55-.74 1.06-1.18 1.53l-1.96-.72a7.5 7.5 0 0 1-1.9 1.1l-.35 2.06a9.7 9.7 0 0 1-3.84 0l-.35-2.06a7.5 7.5 0 0 1-1.9-1.1l-1.96.72a9.6 9.6 0 0 1-1.18-1.53l1.28-1.65a7.4 7.4 0 0 1-.65-2l-1.97-.72a9.6 9.6 0 0 1 0-1.9l1.97-.72c.13-.7.35-1.37.65-2L4.69 6.75c.34-.55.74-1.06 1.18-1.53l1.96.72a7.5 7.5 0 0 1 1.9-1.1l.35-2.06A9.7 9.7 0 0 1 12 2.6"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
      />
    </>
  )}

  {name === 'shopify-bag' && (
    <>
      <path
        d="M6.1 6.7h11.8l1.3 12.4a1.5 1.5 0 0 1-1.5 1.65H6.3a1.5 1.5 0 0 1-1.5-1.65z"
        fill="currentColor"
      />
      <path
        d="M9.1 8V5.9a2.9 2.9 0 0 1 5.8 0V8"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      />
      <path
        d="M13.7 11.3a3.2 3.2 0 0 0-1.85-.55c-1.3 0-2.15.75-2.15 1.75 0 .95.7 1.4 1.65 1.85.95.45 1.2.7 1.2 1.1 0 .4-.35.65-.9.65a3.3 3.3 0 0 1-1.85-.6l-.4 1.5a4 4 0 0 0 2.2.6c1.45 0 2.5-.8 2.5-2 0-1-.7-1.55-1.7-2-.85-.4-1.15-.6-1.15-1 0-.35.3-.6.85-.6.5 0 1 .15 1.4.35z"
        fill="var(--color-bg-page)"
      />
    </>
  )}

  {name === 'idea' && (
    <>
      <path
        d="M9.1 16.2a5.9 5.9 0 1 1 5.8 0v1.05a1.3 1.3 0 0 1-1.3 1.3h-3.2a1.3 1.3 0 0 1-1.3-1.3z"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
      />
      <path d="M10.2 21h3.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      <path
        d="M18.9 2.2l.52 1.48 1.48.52-1.48.52-.52 1.48-.52-1.48L16.9 4.2l1.48-.52z"
