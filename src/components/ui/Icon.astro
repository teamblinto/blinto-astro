  )}

  {name === 'growth' && (
    <>
      <path d="M4.2 3.5v17h16.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M7.8 15.6c2.4-.35 4.15-1.6 5.25-3.75 1.1-2.15 1.9-4 2.4-5.55" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      <path d="M12.9 5.4h3.05v3.05" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}

  {name === 'support' && (
    <>
      <path d="M4.6 14.5v-2.4a7.4 7.4 0 0 1 14.8 0v2.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      <rect x="2.7" y="13.1" width="4" height="6.4" rx="2" stroke="currentColor" stroke-width="1.7" />
      <rect x="17.3" y="13.1" width="4" height="6.4" rx="2" stroke="currentColor" stroke-width="1.7" />
      <path d="M19.4 19.5v.6a2.3 2.3 0 0 1-2.3 2.3h-2.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
