  {name === 'region-bd' && (
    <>
      <circle cx="12" cy="12" r="8.6" stroke="currentColor" stroke-width="1.6" opacity="0.5" />
      <circle cx="12" cy="12" r="3.6" fill="currentColor" opacity="0.5" />
    </>
  )}
</svg>

<style>
  /**
   * `:where()` keeps these defaults at zero specificity, so a consuming
   * component can size a single icon with its own class without having to
   * out-specify this rule.
   */
  :where(.icon) {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
    display: block;
  }
</style>
