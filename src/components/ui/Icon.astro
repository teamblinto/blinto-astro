const { name, size, class: className, label } = Astro.props as Props;

const icon = ICONS[name];
const length = typeof size === 'number' ? `${size}px` : size;
/** Only a px size can seed the intrinsic width/height attributes. */
const intrinsic = typeof size === 'number' ? size : undefined;

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true', focusable: 'false' } as const);
---

<svg
  class:list={['icon', className]}
  width={intrinsic}
  height={intrinsic}
  viewBox={icon.viewBox}
  fill="none"
  style={`--icon-size: ${length}`}
  {...a11y}
><Fragment set:html={icon.body} /></svg>

<style>
  /**
   * `:where()` keeps these defaults at zero specificity, so a consuming
