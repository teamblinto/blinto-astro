  {name === 'region-us' && (
    <>
      <circle cx="12" cy="12" r="8.6" stroke="currentColor" stroke-width="1.6" opacity="0.5" />
      <path d="M3.4 12h17.2" stroke="currentColor" stroke-width="1.6" opacity="0.5" />
      <path d="M12 3.4c2.5 2.4 3.9 5.4 3.9 8.6s-1.4 6.2-3.9 8.6c-2.5-2.4-3.9-5.4-3.9-8.6S9.5 5.8 12 3.4" stroke="currentColor" stroke-width="1.6" opacity="0.5" />
