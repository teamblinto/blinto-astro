---
import { Image } from 'astro:assets';
import PillButton from '~/components/ui/PillButton.astro';
import type { CardTone } from './FeatureCard.astro';

/**
 * Card / Product (Figma 248:4838) — "Blinto product card for the app
 * portfolio. The screenshot slot is a neutral surface carrying an editable
 * pending-note rather than a stand-in photo — set an image fill on the
 * Screenshot frame and turn Show note off once real UI is available. Show
 * button reveals the App Store link."
 *
 * That note is the whole design of this component, so the code follows it
 * literally: with no `screenshot` the slot stays an empty white surface with
 * the pending note, and passing one turns the note off. A stock photo standing
 * in for product UI would be worse than an honest blank.
 */
interface Props {
  name: string;
  description: string;
  tone: CardTone;
  screenshot?: ImageMetadata;
  note?: string;
  cta?: { label: string; href: string };
}

const { name, description, tone, screenshot, note, cta }: Props = Astro.props;

/* The slot is 379x240 inside the 427 card at 1440. See ImageCard on density. */
const SLOT_WIDTH = 379;
const SLOT_HEIGHT = 240;
const densities =
  screenshot && screenshot.width >= SLOT_WIDTH * 2 ? [1, 2] : [1];
---

<article class:list={['product-card', `product-card--${tone}`]}>
  <div class="product-card__slot">
    {screenshot ? (
      <Image
        class="product-card__shot"
        src={screenshot}
        alt={`${name} interface`}
        width={SLOT_WIDTH}
        height={SLOT_HEIGHT}
        {densities}
        loading="lazy"
        decoding="async"
      />
    ) : (
      note && <p class="product-card__note">{note}</p>
    )}
  </div>

  <div class="product-card__details">
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__description">{description}</p>
  </div>

  {cta && (
    <PillButton
      label={cta.label}
      href={cta.href}
      tone="outline"
      target="_blank"
      rel="noopener noreferrer"
    />
  )}
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
  }

  .product-card--blue {
    background-color: var(--color-bg-accent-blue);
  }

  .product-card--yellow {
    background-color: var(--color-bg-accent-yellow);
  }

  .product-card--green {
    background-color: var(--color-bg-accent-green);
  }

  .product-card__slot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 240px;
    padding-inline: var(--space-md);
    overflow: hidden;
    background-color: var(--color-bg-page);
    border: 1px solid var(--color-border-faint);
    border-radius: var(--radius-md);
  }

  .product-card__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .product-card__note {
    /* Body/Default at 50% — Figma's pending-note treatment. */
    font-size: var(--font-size-body-xs);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
    text-align: center;
    opacity: 0.5;
  }

  .product-card__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .product-card__name {
    /* Heading/Card */
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-1);
    font-weight: var(--font-weight-regular);
    line-height: 1.25;
  }

  .product-card__description {
    /* Body/Default */
    font-size: var(--font-size-body-xs);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
  }
</style>
