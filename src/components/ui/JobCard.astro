---
import PillButton from '~/components/ui/PillButton.astro';
import type { CardTone } from './FeatureCard.astro';

/**
 * A job opening: the role, its terms, the application deadline, and a link to
 * the listing on Blinto's hiring platform.
 *
 * Built from the system's own parts — Card / List's pastel body and display
 * heading, Card / Belief's pinned-bottom footer, and the outline Pill Button —
 * because the Figma library has no careers component.
 */
/** Only what the card draws — `Job` in `src/data/types.ts` carries the rest. */
interface Props {
  title: string;
  tone: CardTone;
  /** Employment terms, shown as a row of separated facts. */
  terms: string[];
  deadline: string;
  href: string;
}

const { title, tone, terms, deadline, href }: Props = Astro.props;
---

<article class:list={['job-card', `job-card--${tone}`]}>
  <div class="job-card__body">
    <h3 class="job-card__title">{title}</h3>

    <ul class="job-card__terms">
      {terms.map((term) => <li>{term}</li>)}
    </ul>
  </div>

  <div class="job-card__footer">
    <p class="job-card__deadline">Deadline: {deadline}</p>
    <PillButton
      label="Job Details"
      href={href}
      tone="outline"
      target="_blank"
      rel="noopener noreferrer"
    />
  </div>
</article>

<style>
  .job-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    width: 100%;
    min-height: 280px;
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
  }

  .job-card--blue {
    background-color: var(--color-bg-accent-blue);
  }

  .job-card--yellow {
    background-color: var(--color-bg-accent-yellow);
  }

  .job-card--green {
    background-color: var(--color-bg-accent-green);
  }

  .job-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .job-card__title {
    /* Heading/Row */
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-2);
    font-weight: var(--font-weight-regular);
    line-height: 1.25;
    text-transform: uppercase;
  }

  .job-card__terms {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    /* Body/Default */
    font-size: var(--font-size-body-xs);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
  }

  .job-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .job-card__deadline {
    /* Body/Subheading */
    font-size: var(--font-size-body-xs);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
  }
</style>
