---
import { Image } from 'astro:assets';
import Icon from '~/components/ui/Icon.astro';

/**
 * Portfolio tile: a shot of the site, its name, its sector, and a link out to
 * the live site.
 *
 * The Figma library has no portfolio component, so this is assembled from the
 * system's own parts — Card / Image's tile and radius over Card / Belief's
 * name/role attribution pairing — so a row of these sits in the same rhythm as
 * every other card grid. The whole tile is the link, and the "Visit Site" row
 * is the visible affordance rather than a second, competing target.
 */
interface Props {
  name: string;
  sector: string;
  href: string;
  shot: ImageMetadata;
  /** Designed slot size in px. */
  width: number;
  height: number;
  linkLabel?: string;
}

const {
  name,
  sector,
  href,
  shot,
  width,
  height,
  linkLabel = 'Visit Site',
}: Props = Astro.props;

/* Only offer 2x where the source actually has the pixels — see ImageCard. */
const densities = shot.width >= width * 2 ? [1, 2] : [1];
---

<a class="work-card" {href} target="_blank" rel="noopener noreferrer">
  <Image
    class="work-card__shot"
    src={shot}
    alt={`${name} website`}
    {width}
    {height}
    {densities}
    loading="lazy"
    decoding="async"
  />

  <div class="work-card__meta">
    <div class="work-card__identity">
      <h3 class="work-card__name">{name}</h3>
      <p class="work-card__sector">{sector}</p>
    </div>

    <span class="work-card__link">
      {linkLabel}
      <Icon name="arrow-right" size="1em" />
    </span>
  </div>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    color: var(--color-text-primary);
  }

  .work-card__shot {
    width: 100%;
    height: auto;
    aspect-ratio: var(--work-card-ratio, 770 / 534);
    object-fit: cover;
    border-radius: var(--radius-md);
    /* Holds the tile's shape while the image decodes. */
    background-color: var(--color-border-faint);
  }

  .work-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-sm);
  }

  .work-card__identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .work-card__name {
    /* Heading/Row */
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-2);
    font-weight: var(--font-weight-regular);
    line-height: 1.25;
    text-transform: uppercase;
  }

  .work-card__sector {
    /* Body/Default */
    font-size: var(--font-size-body-xs);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
  }

  .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    /* Label/Button */
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--color-text-brand);
  }

  .work-card:hover .work-card__name,
  .work-card:focus-visible .work-card__name {
    color: var(--color-text-brand);
  }

  .work-card:hover .work-card__link {
    text-decoration: underline;
  }
</style>
