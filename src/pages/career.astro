---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/page/Hero.astro';
import BeliefGrid from '~/components/sections/page/BeliefGrid.astro';
import JobGrid from '~/components/sections/page/JobGrid.astro';
import ProcessGrid from '~/components/sections/page/ProcessGrid.astro';
import Faq from '~/components/sections/Faq.astro';
import Cta from '~/components/sections/Cta.astro';
import * as page from '~/data/pages/career';
import { ORG_LEGAL_NAME, idFor, type SchemaContext } from '~/data/seo';
import { offices } from '~/data/site';

/**
 * Migrated from https://blinto.co/career/, at the same path, so the link needs
 * no redirect at launch. Section order follows the original: hero, benefits,
 * openings, hiring journey, FAQ, CTA.
 */

/**
 * One JobPosting per opening. Every field restates something the card already
 * prints: `validThrough` is its deadline, so a role that has closed says so
 * rather than looking open forever, and `baseSalary` is the range it states.
 * The office comes from `site.ts` rather than being retyped here — the FAQ
 * says the company is 100% on-site, and Dhaka is where the roles sit.
 *
 * `datePosted` is absent, and deliberately: Google wants one, but the old site
 * never published a posting date and inventing one would be fabricating data.
 * These listings need refreshing with real dates and deadlines anyway — every
 * one closed in February 2026.
 */
const dhaka = offices.find((office) => office.name === 'Dhaka');

const jobPostings = ({ origin }: SchemaContext) =>
  page.jobs.map((job) => ({
    '@type': 'JobPosting',
    title: job.title,
    description: `${job.title}. ${job.terms.join('. ')}.`,
    employmentType: 'FULL_TIME',
    hiringOrganization: {
      '@id': idFor.organization(origin),
      name: ORG_LEGAL_NAME,
    },
    jobLocationType: 'On-site',
    ...(dhaka
      ? {
          jobLocation: {
            '@type': 'Place',
            address: {
              '@type': 'PostalAddress',
              streetAddress: dhaka.address,
              addressLocality: 'Dhaka',
              addressCountry: 'BD',
            },
          },
        }
      : {}),
    ...(job.salary
      ? {
          baseSalary: {
            '@type': 'MonetaryAmount',
            currency: 'BDT',
            value: {
              '@type': 'QuantitativeValue',
              minValue: job.salary.min,
              maxValue: job.salary.max,
              unitText: 'MONTH',
            },
          },
        }
      : {}),
    validThrough: job.deadlineIso,
    directApply: false,
    url: job.href,
  }));
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  faqs={page.faqs}
  schema={jobPostings}
>
  <Hero
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    subheading={page.hero.subheading}
    actions={page.hero.actions}
  />

  <BeliefGrid
    copy={page.benefitsSection}
    cells={page.benefitCells}
    cardMin={300}
    cellMinHeight={200}
  />

  <JobGrid
    copy={page.openingsSection}
    jobs={page.jobs}
    cardMin={380}
    id="opening"
  />

  <ProcessGrid copy={page.journeySection} steps={page.journeySteps} />

  <Faq
    eyebrow={page.faqSection.eyebrow}
    heading={page.faqSection.heading}
    items={page.faqs}
    compact
  />

  <Cta
    kicker={page.closingCta.kicker}
    heading={page.closingCta.heading}
    actions={page.closingCta.actions}
    backdrop={page.closingCta.backdrop}
  />
</BaseLayout>
