---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/page/Hero.astro';
import BeliefGrid from '~/components/sections/page/BeliefGrid.astro';
import StageGrid from '~/components/sections/page/StageGrid.astro';
import ProcessGrid from '~/components/sections/page/ProcessGrid.astro';
import ProductGrid from '~/components/sections/page/ProductGrid.astro';
import Faq from '~/components/sections/Faq.astro';
import Cta from '~/components/sections/Cta.astro';
import * as page from '~/data/pages/shopify-apps';
import { idFor, type SchemaContext } from '~/data/seo';

/**
 * Our Apps — Figma "Our Apps · Desktop" (269:5897), at /shopify-apps/ per the
 * approved sitemap. Section order is the design's: hero, where you are, the
 * apps, find your fit, how we build, the journey, product tour, why it
 * matters, FAQ, CTA.
 */

/**
 * The apps themselves, as software rather than as page content, wrapped in the
 * ItemList this page is a collection of. Each carries only what the page states
 * — no ratings, prices or install counts, none of which are verifiable here.
 */
const appPortfolio = ({ canonical, origin }: SchemaContext) => [
  {
    '@type': 'ItemList',
    '@id': `${canonical.href}#apps`,
    name: 'Shopify apps built by Blinto',
    itemListOrder: 'https://schema.org/ItemListUnordered',
    numberOfItems: page.appCards.length,
    itemListElement: page.appCards.map((card, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: page.products[index].name,
        applicationCategory: 'BusinessApplication',
        applicationSubCategory: 'Shopify app',
        operatingSystem: 'Shopify',
        description: card.body,
        featureList: card.features,
        author: { '@id': idFor.organization(origin) },
        publisher: { '@id': idFor.organization(origin) },
      },
    })),
  },
];
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  ogImage={page.hero.banner.src}
  pageType="CollectionPage"
  faqs={page.faqs}
  schema={appPortfolio}
>
  <Hero
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    subheading={page.hero.subheading}
    actions={page.hero.actions}
    banner={page.hero.banner}
  />

  <BeliefGrid
    copy={page.opportunitySection}
    cells={page.opportunityCells}
    layout="row"
  />

  <StageGrid
    copy={page.appsSection}
    cards={page.appCards}
    align
    id="the-apps"
  />

  <StageGrid
    copy={page.fitSection}
    cards={page.fitCards}
    note={page.fitNote}
  />

  <BeliefGrid
    copy={page.buildSection}
    cells={page.buildCells}
    cardMin={260}
    cellMinHeight={220}
  />

  <ProcessGrid
    copy={page.journeySection}
    steps={page.journeySteps}
    note={page.journeyNote}
  />

  <ProductGrid
    copy={page.tourSection}
    products={page.products}
    id="product-tour"
  />

  <BeliefGrid
    copy={page.whySection}
    cells={page.whyCells}
    cardMin={500}
    actions={[page.whyAction]}
  />

  <Faq
    eyebrow={page.faqSection.eyebrow}
    heading={page.faqSection.heading}
    subheading={page.faqSection.subheading}
    items={page.faqs}
    compact
  />

  <Cta
    kicker={page.closingCta.kicker}
    heading={page.closingCta.heading}
    body={page.closingCta.body}
    actions={page.closingCta.actions}
    backdrop={page.closingCta.backdrop}
  />
</BaseLayout>
