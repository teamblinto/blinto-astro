---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/page/Hero.astro';
import ProcessGrid from '~/components/sections/page/ProcessGrid.astro';
import StageGrid from '~/components/sections/page/StageGrid.astro';
import BeliefGrid from '~/components/sections/page/BeliefGrid.astro';
import PersonGrid from '~/components/sections/page/PersonGrid.astro';
import Faq from '~/components/sections/Faq.astro';
import Cta from '~/components/sections/Cta.astro';
import * as page from '~/data/about';

/**
 * About Us (Figma 251:4816).
 *
 * Section order is the design's: hero, our story, what we do, how we think,
 * the team, how we work, FAQ, CTA. Navigation and footer come from BaseLayout.
 *
 * Five of the six shells here were built for the service pages. The two rows
 * that go 4-up rather than 3-up pass `cardMin={260}`, which is the min-width
 * Figma sets on those cards; How We Work is a BeliefGrid whose cells happen to
 * all be photo tiles.
 */
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  pageType="AboutPage"
  faqs={page.faqs}
>
  <Hero
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    subheading={page.hero.subheading}
    actions={page.hero.actions}
    banner={page.hero.banner}
  />

  <ProcessGrid
    copy={page.storySection}
    steps={page.storySteps}
    cardMin={260}
  />

  <StageGrid copy={page.whatWeDoSection} cards={page.whatWeDoCards} />

  <BeliefGrid
    copy={page.howWeThinkSection}
    cells={page.howWeThinkCells}
    cardMin={260}
    cellMinHeight={200}
  />

  <PersonGrid copy={page.teamSection} people={page.team} />

  <BeliefGrid copy={page.howWeWorkSection} cells={page.howWeWorkCells} />

  <Faq
    eyebrow={page.faqSection.eyebrow}
    heading={page.faqSection.heading}
    subheading={page.faqSection.subheading}
    items={page.faqs}
    compact
  />

  <Cta
    kicker={page.closingCta.kicker}
    heading={page.closingCta.heading}
    body={page.closingCta.body}
    actions={page.closingCta.actions}
    backdrop={page.closingCta.backdrop}
  />
</BaseLayout>
