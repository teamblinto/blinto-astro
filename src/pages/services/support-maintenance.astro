---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/service/Hero.astro';
import ListWithImage from '~/components/sections/service/ListWithImage.astro';
import StageGrid from '~/components/sections/service/StageGrid.astro';
import BeliefGrid from '~/components/sections/service/BeliefGrid.astro';
import ProcessGrid from '~/components/sections/service/ProcessGrid.astro';
import Faq from '~/components/sections/Faq.astro';
import Cta from '~/components/sections/Cta.astro';
import * as page from '~/data/services/support-maintenance';

/**
 * Service — App Support & Maintenance (Figma 240:3463).
 *
 * Section order is the design's: hero, after launch, where you are, what we
 * do, what we investigate, our process, support models, why Blinto, keep
 * learning, FAQ, CTA. Navigation and footer come from BaseLayout.
 *
 * Support Models reuses StageGrid: Figma builds it from the same Card /
 * Feature in its short, button-less form as Where You Are.
 */

/** Surfaces the FAQ copy to search engines as structured data. */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />

  <Hero
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    subheading={page.hero.subheading}
    actions={page.hero.actions}
    banner={page.hero.banner}
  />

  <ListWithImage
    copy={page.afterLaunchSection}
    panel={page.afterLaunchPanel}
    image={page.afterLaunchImage}
  />

  <StageGrid copy={page.stagesSection} cards={page.stageCards} />

  <BeliefGrid copy={page.whatWeDoSection} cells={page.whatWeDoCells} />

  <ListWithImage
    copy={page.investigateSection}
    panel={page.investigatePanel}
    image={page.investigateImage}
  />

  <ProcessGrid
    id="our-process"
    copy={page.processSection}
    steps={page.processSteps}
    action={page.processAction}
  />

  <StageGrid copy={page.supportModelsSection} cards={page.supportModels} />

  <BeliefGrid copy={page.whyBlintoSection} cells={page.whyBlintoCells} />

  <ListWithImage
    copy={page.keepLearningSection}
    panel={page.keepLearningPanel}
    image={page.keepLearningImage}
    actions={page.keepLearningActions}
  />

  <Faq
    eyebrow={page.faqSection.eyebrow}
    heading={page.faqSection.heading}
    subheading={page.faqSection.subheading}
    items={page.faqs}
    compact
  />

  <Cta
    kicker={page.closingCta.kicker}
    heading={page.closingCta.heading}
    body={page.closingCta.body}
    actions={page.closingCta.actions}
    backdrop={page.closingCta.backdrop}
  />
</BaseLayout>
