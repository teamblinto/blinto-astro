---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/page/Hero.astro';
import BeliefGrid from '~/components/sections/page/BeliefGrid.astro';
import WorkGrid from '~/components/sections/page/WorkGrid.astro';
import QuoteGrid from '~/components/sections/page/QuoteGrid.astro';
import Faq from '~/components/sections/Faq.astro';
import Cta from '~/components/sections/Cta.astro';
import * as page from '~/data/services/website-maintenance';

/**
 * Migrated from https://blinto.co/website-maintenance/, now under /services/;
 * the old path 301s here (see the redirect map in redirects.mjs).
 *
 * The original's "Explore More Projects" button pointed at /works/, which maps
 * to /case-studies/ — a page that does not exist yet. It is dropped rather
 * than shipped as a dead link; the three project tiles above it still link out
 * to the live client sites. Restore it when Case Studies lands.
 * Section order follows the original: hero, what's included, industries,
 * recent projects, why Blinto, testimonials, FAQ, CTA.
 */
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  faqs={page.faqs}
  service={{
    name: 'Website Maintenance',
    description: page.meta.description,
    serviceType: 'Website maintenance',
  }}
>
  <Hero
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    subheading={page.hero.subheading}
    actions={page.hero.actions}
  />

  <BeliefGrid
    copy={page.includedSection}
    cells={page.includedCells}
    cardMin={300}
  />

  <BeliefGrid
    copy={page.industriesSection}
    cells={page.industryCells}
    cardMin={260}
    cellMinHeight={140}
  />

  <WorkGrid copy={page.projectsSection} items={page.projects} cardMin={400} />

  <BeliefGrid copy={page.whySection} cells={page.whyCells} cardMin={300} />

  <QuoteGrid
    copy={page.quotesSection}
    quotes={page.quotes}
    cardMin={500}
    cardMinHeight={420}
  />

  <Faq
    eyebrow={page.faqSection.eyebrow}
    heading={page.faqSection.heading}
    items={page.faqs}
    compact
  />

  <Cta
    kicker={page.closingCta.kicker}
    heading={page.closingCta.heading}
    body={page.closingCta.body}
    actions={page.closingCta.actions}
    backdrop={page.closingCta.backdrop}
  />
</BaseLayout>
